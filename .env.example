# coach.ai — environment example (I5 target).
# Every env var the code reads must appear here, and every var here must be
# documented; `just check:env` enforces the superset relationship.
#
# MVP has NO secret (music via public SoundCloud oEmbed, D8). OAuth/secret only
# arrives with F-08 (SoundCloud 2.1+PKCE). Keep this file minimal + secret-free.

# --- API (apps/api) -----------------------------------------------------------
# Postgres connection for the FastAPI service (T-10/T-30). Dev default points at
# local Testcontainers-style Postgres. No credentials in this file's values.
DATABASE_URL=postgres://user:pass@localhost:5432/coach
# OpenAPI is served at /openapi.json; consumed by the generated api-client (T-31).
API_PORT=8000
# Optional AI-loop write path config (F-04/F-07); unset = disabled in MVP.
# AI_API_KEY=

# --- Web (apps/web) + Mobile (apps/mobile) ------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
